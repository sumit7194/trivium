#!/bin/zsh
# Runs the audit sweeps on every commit, reporting DELTAS against the previous run.
#
# WHY A HOOK AND NOT A SCRIPT I RUN. audit_sweep.py is fully mechanical and caught
# nothing between the two times it ran today -- both times because a peer prompted me.
# Mechanical was never the property that made a fix stick.
#
#   quantum's form, sharper than mine: A CHECK IS DURABLE WHEN IT RIDES ON AN ACTION
#   ALREADY BEING TAKEN FOR ANOTHER REASON. The hook is not special because it is a
#   hook; it is special because committing is something I do anyway, so the check costs
#   no separate act of will.
#
# This REPORTS and does not block: the sweeps are triage-heavy (1 real hit in ~12 for
# "independent", 2 in 6 for buried caveats) and a blocking check with that hit rate
# would be disabled within a day. Blocking is for assertions with a known denominator.
#
# ---------------------------------------------------------------------------
# 2026-09-02: THIS HOOK WAS BLOCKING EVERY COMMIT, SILENTLY, AND THE COMMENT
# DIRECTLY ABOVE SAID IT COULD NOT.
#
#   APP=$(... | grep -cE "^  (APPEND-ONLY|...)")
#
# `grep -c` exits 1 when it counts ZERO. Under `set -e` that aborted the hook
# before any output, and git reported nothing at all -- no message, no diff, the
# commit simply did not happen. Three separate attempts read as "the command
# produced no output".
#
# It went to zero because append_only.py measures a window RELATIVE TO NOW
# ("12 hours ago"). Once the last commit aged past that window the tool correctly
# reported "fewer than 2 revisions -- nothing to compare", the grep counted 0, and
# `set -e` did the rest.
#
# TWO DEFECTS, AND THE SECOND IS WORSE THAN THE CRASH:
#   1. a zero count is a legitimate measurement, not an error
#   2. "0 sections" and "the check could not run" produced THE SAME NUMBER, so the
#      stored delta would have read 5 -> 0 as five documents ceasing to be
#      append-only. A false alarm of the worst kind, from a check that had merely
#      run out of input. This is the silent-null shape the sweep exists to find,
#      in the sweep itself.
#   3. and a delta against a SLIDING window measures the clock as much as the repo.
#
# Fixed: sweep failures are reported and never block; an uncomparable window is
# recorded as "-" and is never differenced against a number.
# ---------------------------------------------------------------------------
R=$(git rev-parse --show-toplevel)
S=$R/.git/audit_counts
C=/Users/sumit/Github/.claude-coordination
[[ -f $C/audit_sweep.py ]] || exit 0

SW=$(python3 $C/audit_sweep.py $R 2>&1); SW_RC=$?
if (( SW_RC != 0 )); then
  echo "  audit: audit_sweep.py FAILED (rc=$SW_RC) -- not blocking, but the sweep did not run"
  echo "$SW" | tail -3
  HITS="ERR"
else
  HITS=$(print -r -- "$SW" | grep -oE "— [0-9]+ hits" | grep -oE "[0-9]+" | paste -sd, -)
  [[ -z "$HITS" ]] && HITS="ERR"     # parsed nothing: the format changed, not "zero hits"
fi

AO=$(python3 $C/append_only.py $R "12 hours ago" 2>&1); AO_RC=$?
if (( AO_RC != 0 )); then
  echo "  audit: append_only.py FAILED (rc=$AO_RC) -- not blocking"
  APP="ERR"
elif print -r -- "$AO" | grep -q "nothing to compare"; then
  APP="-"                            # NOT zero. The window holds too few revisions.
else
  APP=$(print -r -- "$AO" | grep -cE "^  (APPEND-ONLY|SECTIONS-ONLY-ADDED)" || true)
fi

# STORE THE DENOMINATOR. Found 2026-09-21, prompted by tabula's rule that the ratios
# BETWEEN a tool's outputs are the part nobody is assigned to build.
#
# This hook has published six raw hit-counts on every commit and read DELTAS ON LEVELS.
# It never stored the corpus size, so "483 -> 500" cannot be separated from "the corpus
# got bigger". Measured today: 1,579 markdown lines added while hits rose 17. Rate went
# 31.9 -> 33.0 per 100KB, i.e. essentially flat -- the delta I have been reading as a
# signal was corpus growth.
#
# I THEN CLAIMED THIS WAS PERMANENTLY UNMAKEABLE. THAT WAS FALSE, and checkable in one
# command -- which I did not run before asserting it, inside this very comment, in a
# commit whose whole subject was that I had been reading unchecked levels.
#
# The corpus is IN GIT. `git ls-tree` recovers the denominator at any past revision and
# `git archive` re-runs the sweep there. tabula's corrected taxonomy is the right one:
# the denominator does not have to be STORED, it has to be RECOVERABLE -- and recoverable
# in principle is worth nothing unless something actually re-runs it. The real split is
# deterministic-and-gated versus deterministic-but-never-checked. This hook is the second:
# regenerable, not orphaned. Their category 3, not category 4.
#
# Rebuilt the history that was supposedly lost:
#     2026-08-23   474 hits  1397 KB   33.9 per 100KB
#     2026-09-05   483 hits  1447 KB   33.4 per 100KB
#     2026-09-21   500 hits  1513 KB   33.0 per 100KB
# The RATE HAS BEEN FALLING while the levels rose. Every delta ever read off this hook as
# a rise was a fall in the quantity that means anything.
KB=$(git ls-files '*.md' | xargs wc -c 2>/dev/null | tail -1 | awk '{printf "%d", $1/1024}')
DOCS=$(git ls-files '*.md' | wc -l | tr -d ' ')
[[ -z "$KB" || "$KB" == "0" ]] && KB="MISSING"      # never fabricate a denominator
[[ -z "$DOCS" ]] && DOCS="MISSING"


# LIVE-CHECKPOINT GUARD. deepstrain, 2026-09-22: `git add -A` swept a 19 MB mid-run
# checkpoint into their repo -- it rewrites every 50 templates -- and it landed under a
# commit message about something else. "Right message, wrong content, and the diff
# nobody reads is where that hides."
#
# A NAME PATTERN CANNOT CATCH THIS. This repo tracks three *_ckpt.json files that are
# resume caches read by scripts that still exist, committed once in July and never
# rewritten. Same names, opposite situation. The property that separates them is not
# what the file is called but WHETHER A JOB IS WRITING IT RIGHT NOW.
#
# So: warn when a staged file is checkpoint-shaped AND was modified in the last 10
# minutes. Static caches never trip it; live state always does.
# NOT `find -newermt`. On this machine `find` is bfs, which rejects "10 minutes ago"
# (it wants ISO 8601) and writes the error to stderr -- so with 2>/dev/null the
# predicate returned EMPTY on every call and THE GUARD FIRED NEVER. I shipped it with
# a README and a commit message claiming both directions verified, while the control
# output on my own screen read WRONG on the live leg. stat+date depends on no
# timestamp parser and no choice of find.
NOW=$(date +%s)
STAGED_LIVE=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
  | grep -iE 'ckpt|checkpoint|\.npz$|\.pkl$|_state\.|resume' \
  | while read -r f; do
      [[ -f "$f" ]] || continue
      M=$(stat -f %m "$f" 2>/dev/null) || continue
      (( NOW - M < 600 )) && echo "$f"
    done)
if [[ -n "$STAGED_LIVE" ]]; then
  echo "  !! LIVE CHECKPOINT STAGED -- modified in the last 10 min, so a job may be writing it:"
  print -r -- "$STAGED_LIVE" | sed 's/^/       /'
  echo "     Committing crash-survival state pins a moment nobody chose. Untrack unless it"
  echo "     is a finished artifact that backs a claim."
fi

NEW="$HITS|$APP|${KB}KB|${DOCS}d"

if [[ -f $S ]]; then
  OLD=$(cat $S)
  if [[ "$OLD" != "$NEW" ]]; then
    echo "  audit delta: $OLD -> $NEW  (sweep hits | append-only sections)"
    if [[ "$OLD" == *"|-"* || "$NEW" == *"|-"* ]]; then
      echo "  '-' means the append-only window held too few revisions to compare — NOT a fall to zero"
    fi
    echo "  a rise is not necessarily a defect -- see the false-positive notes in the source"
    # Read the RATE, not the level: hits per 100KB. A rise in raw hits that tracks
    # corpus growth is not a finding.
    if [[ "$KB" != "MISSING" && "$OLD" == *"KB"* ]]; then
      OKB=${${(s:|:)OLD}[3]%KB}; OHITS=${${(s:|:)OLD}[1]%%,*}; NHITS=${HITS%%,*}
      if [[ -n "$OKB" && "$OKB" != "0" ]]; then
        print -r -- "  rate: $(( OHITS * 102400.0 / (OKB * 1024) )) -> $(( NHITS * 102400.0 / (KB * 1024) )) hits/100KB  <- READ THIS, not the level"
      fi
    fi
  fi
else
  echo "  audit baseline set: $NEW"
fi
echo "$NEW" > $S
# --- leg gate (added 2026-09-05) -----------------------------------------------
# Encodes the leg design requirement so it is checked by execution rather than by
# being read. tabula: "visibility is a weaker referee than executability, and I
# would rather be corrected by my own suite than by my own prose."
#
# WHY IT REPORTS AND DOES NOT BLOCK, despite having no triage cost and therefore
# qualifying to block under this hook's own stated standard: on 2026-09-02 a
# blocking check in this same hook silently killed every commit in the repo for
# hours, and the comment above it said it could not. The risk is asymmetric --
# a missed leg warning costs one bad leg; a wedged hook costs the whole record.
# Revisit once this gate has run clean for a week.
if [[ -f $C/leg_gate.py ]]; then
  LG=$(python3 $C/leg_gate.py 2>&1); LG_RC=$?
  echo "$LG"
  [[ $LG_RC -ne 0 ]] && echo "  ^ leg gate FAILING -- not blocking, but fix before the leg is run"
fi


exit 0
